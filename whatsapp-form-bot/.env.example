# Server Port
PORT=3000

# Security Secret Token to authenticate requests from Google Apps Script
# Change this to any strong random string of your choice
SECRET_TOKEN=my_super_secret_token_123

# Target WhatsApp Phone Number(s) to receive notifications.
# MUST be in international format without + or spaces, ending with @c.us
# Example for India (+91 9876543210): 919876543210@c.us
# Multiple numbers can be separated by commas: 919876543210@c.us,919123456789@c.us
TARGET_NUMBERS=919876543210@c.us
